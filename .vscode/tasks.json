{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Flutter pub get",
        "type": "shell",
        "command": "bash",
        "args": [
            "-c",
            "fvm flutter pub get"
        ],
        "presentation": {
            "reveal": "always",
            "echo": true,
            "panel": "shared"
        },
        "group": "build"
    },
    {
        "label": "Full Flutter Clean & Build Runner",
        "type": "shell",
        "command": "bash",
        "args": [
            "-c",
            "fvm flutter clean && fvm flutter pub get && fvm dart run build_runner build --delete-conflicting-outputs"
        ],
        "presentation": {
            "reveal": "always",
            "echo": true,
            "panel": "shared"
        },
        "group": "build"
    },
    {
        "label": "Flutter Build Runner",
        "type": "shell",
        "command": "fvm",
        "args": [
            "dart",
            "run",
            "build_runner",
            "build",
            "--delete-conflicting-outputs"
        ],
        "presentation": {
            "reveal": "always",
            "echo": true,
            "focus": false,
            "panel": "shared"
        },
        "problemMatcher": [],
        "group": {
            "kind": "build",
            "isDefault": true
        }
    },
    
    {
      "label": "Build APK (dev flavor)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "fvm dart update_app_version.dart && fvm flutter build apk --release -t lib/main_dev.dart --flavor dev"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build APK (staging flavor)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "fvm dart update_app_version.dart && fvm flutter build apk --release -t lib/main_stag.dart --flavor stag"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Build APK (prod flavor)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "fvm dart update_app_version.dart && fvm flutter build apk --release -t lib/main.dart --flavor prod"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
]
}
